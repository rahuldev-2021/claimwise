# Backend API origin (no trailing slash). Must match how you open the UI:
# - UI at http://localhost:5173 → use http://localhost:8000
# - UI at http://127.0.0.1:5173 → use http://127.0.0.1:8000
# Do not mix localhost and 127.0.0.1 (auth cookies will not work).
#
# Leave empty to call /api on the Vite dev server (proxy to the same URL below in vite.config).
# VITE_API_BASE_URL=
VITE_API_BASE_URL=http://localhost:8000

# Optional: Vite dev server port (default 5173)
# VITE_DEV_PORT=5173
