APP_NAME=CLAIMWISE
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1
SAMPLE_DATA_DIR=data/sample

# NLP (requires spacy in requirements.txt +: python -m spacy download en_core_web_sm)
NLP_ENABLE_SPACY=true

# Phase 5 LLM reasoning
LLM_ENABLED=true
# LLM_PROVIDER=mock
# LLM_FALLBACK_PROVIDER=mock
# LLM_MODEL=
# LLM_PROMPT_VERSION=assessment_v2
# LLM_CONTEXT_MAX_CHARS=12000
# LLM_CONTEXT_MAX_PASSAGES=8
# LLM_MAX_OUTPUT_TOKENS=0
# LLM_TV_TEMPLATE_FALLBACK=true
# PHASE5_REUSE_CACHED_STAGES=true
# PHASE5_REUSE_LLM_IF_FINGERPRINT_MATCH=true

# Optional LLM NLP fallback (off by default; uses Phase 5 LLM_PROVIDER / keys when enabled)
LLM_NLP_ENABLED=false
LLM_NLP_FALLBACK_MODE=conditional
# LLM_NLP_PROVIDER=
# LLM_NLP_MODEL=
LLM_NLP_MIN_TRIGGER_COUNT=2
# RAG investigation worker
# RAG_INVESTIGATION_ENABLED=true
# RAG_WORKER_AUTO_INGEST_SAMPLE=false
# RAG_UPLOAD_MIN_TEXT_CHARS=40
# INVESTIGATION_RUN_TECHNICAL_VALIDATION=true
# INVESTIGATION_SKIP_TV_IF_PRESENT=true
# HISTORICAL_REPAIRS_INGEST_ENABLED=false

# Slow gateways + large outputs: allow 120s per attempt (SDK retries disabled by default)
# LLM_NLP_TIMEOUT_SECONDS=120
# LLM_NLP_MAX_OUTPUT_TOKENS=1536
# LLM_OPENAI_SDK_MAX_RETRIES=0

# MLflow OpenAI-compatible gateway (Lucius-style; CHATGPT_* is source of truth):
# CHATGPT_API_KEY=none
# CHATGPT_BASE_URL=http://1.6.37.57/gateway/mlflow/v1/chat/completions
# CHATGPT_MODEL=qwen-coder-2
# LLM_PROVIDER=litellm
# LLM_FALLBACK_PROVIDER=mock
# LLM_COMPACT_CONTEXT=true
# LLM_JSON_REPAIR_ENABLED=true
# LLM_RAW_OUTPUT_LOG_CHARS=3000
# LLM_RAW_OUTPUT_PREVIEW_CHARS=4000
# litellm is in requirements.txt
# Runtime: base URL is stripped to .../v1; LiteLLM model id is openai/qwen-coder-2
# Verify: GET /api/v1/llm/health → gateway_base_url, litellm_resolved_model

# Optional: disable Chroma anonymized telemetry (also set in code for local dev)
ANONYMIZED_TELEMETRY=FALSE

# Phase 6 financial validation (PROVISIONAL config in config/financial/)
FINANCIAL_ENABLED=true
FINANCIAL_CONFIG_DIR=config/financial
FINANCIAL_MODEL_REGISTRY_DIR=data/financial_models
FINANCIAL_TRAINING_DATA_PATH=
FINANCIAL_REQUIRE_MODELS=false
# Evaluation demos (synthetic_v1 ML predictions in UI scenarios) — ml deps are in requirements.txt
FINANCIAL_EXPERIMENTAL_MODELS_ENABLED=true
FINANCIAL_EXPERIMENTAL_REGISTRY_DIR=data/financial_models/synthetic_v1/experimental_artifacts

# CORS (must include your Vite dev origin; match localhost vs 127.0.0.1 with the UI)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth (MongoDB + JWT) — required for sign-in
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=claimwise
# Investigation jobs run inside the API process (set false only if you use python -m app.worker)
EMBED_CLAIM_WORKER=true
JWT_SECRET=dev-only-change-this-secret
JWT_ISSUER=claimwise
JWT_AUDIENCE=claimwise-app
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
