          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="features" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A73E8;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.857;exitDx=0;exitDy=0;entryX=1;entryY=0.294;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="orch" target="cost_ep">
