<mxfile host="app.diagrams.net">
  <diagram id="claimwise-arch" name="ClaimWise Architecture">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1170" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;ClaimWise – AI Repair Claim Validation on Google Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ML predicts cost &amp;amp; labour · RAG retrieves similar repairs · Gemini explains · Rule engine recommends · Agent decides&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="20" y="5" width="1870" height="45" as="geometry" />
        </mxCell>

        <!-- Layer containers -->
        <mxCell id="cA" value="1. Data Sources" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#F8F9FA;strokeColor=#9E9E9E;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="220" height="760" as="geometry" />
        </mxCell>
        <mxCell id="cB" value="2. Ingestion &amp;amp; Privacy" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#E8F0FE;strokeColor=#4285F4;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="70" width="240" height="760" as="geometry" />
        </mxCell>
        <mxCell id="cC" value="3. Data Platform" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#E6F4EA;strokeColor=#34A853;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="240" height="760" as="geometry" />
        </mxCell>
        <mxCell id="cD" value="4. AI / ML &amp;amp; NLP – Vertex AI" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#F9AB00;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="810" y="70" width="540" height="760" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Offline NLP: batch on closed claims" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=2;fontSize=11;fillColor=#FEF7E0;strokeColor=#F9AB00;dashed=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="825" y="100" width="250" height="715" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Online NLP: each new claim at scoring time" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=2;fontSize=11;fillColor=#FCE8E6;strokeColor=#EA4335;dashed=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="100" width="245" height="715" as="geometry" />
        </mxCell>
        <mxCell id="cE" value="5. Decision &amp;amp; Serving" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#F3E8FD;strokeColor=#A142F4;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1380" y="70" width="260" height="760" as="geometry" />
        </mxCell>
        <mxCell id="cF" value="6. Consumption" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#E0F7FA;strokeColor=#12B5CB;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1670" y="70" width="220" height="760" as="geometry" />
        </mxCell>

        <!-- 1. Data Sources -->
        <mxCell id="src_dealer" value="&lt;b&gt;Dealer Claim Portal / DMS&lt;/b&gt;&lt;br&gt;complaint, diagnosis, recommended repair, parts $, labour hrs, inspection evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="src_hist" value="&lt;b&gt;Historical Claims Warehouse&lt;/b&gt;&lt;br&gt;millions of closed claims + final outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="src_parts" value="&lt;b&gt;Parts Catalogue &amp;amp; Price List&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="src_rates" value="&lt;b&gt;Labour Time Guides&lt;/b&gt;&lt;br&gt;dealer / region labour rates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="src_docs" value="&lt;b&gt;Service Reports&lt;/b&gt;&lt;br&gt;inspection notes, scans, photos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="495" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="src_vehicle" value="&lt;b&gt;Vehicle Master &amp;amp; Warranty&lt;/b&gt;&lt;br&gt;model, year, mileage, coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="src_note" value="&lt;i&gt;Structured: parts $, labour hrs, vehicle, dealer, outcome&lt;br&gt;Unstructured: complaint, diagnosis, recommendation text&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6368;" vertex="1" parent="1">
          <mxGeometry x="35" y="660" width="195" height="80" as="geometry" />
        </mxCell>

        <!-- 2. Ingestion & Privacy -->
        <mxCell id="apigw" value="&lt;b&gt;Apigee / API Gateway&lt;/b&gt;&lt;br&gt;secure real-time claim intake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pubsub" value="&lt;b&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;claim events (async, decoupled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="205" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gcs_raw" value="&lt;b&gt;Cloud Storage – Raw Zone&lt;/b&gt;&lt;br&gt;batch extracts via Storage Transfer / Datastream CDC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="290" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dataflow" value="&lt;b&gt;Dataflow&lt;/b&gt; (batch + streaming)&lt;br&gt;clean, validate, join, normalize&lt;br&gt;Document AI OCR for scans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="400" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dlp" value="&lt;b&gt;Sensitive Data Protection (DLP)&lt;/b&gt;&lt;br&gt;mask names, VIN, phone, address before storage &amp;amp; LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="510" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="composer" value="&lt;b&gt;Cloud Composer / Scheduler&lt;/b&gt;&lt;br&gt;batch orchestration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="620" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 3. Data Platform -->
        <mxCell id="bq_text" value="&lt;b&gt;BigQuery – Text Corpus&lt;/b&gt;&lt;br&gt;complaint, diagnosis, recommendation (de-identified)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bq_curated" value="&lt;b&gt;BigQuery – Curated Claims&lt;/b&gt;&lt;br&gt;parts $, labour hrs, vehicle, dealer, region, outcome + extracted JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="220" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="feature_store" value="&lt;b&gt;Vertex AI Feature Store&lt;/b&gt;&lt;br&gt;vehicle, engine, repair action, part no., dealer/region, complexity, catalogue price, guide hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="310" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dataplex" value="&lt;b&gt;Dataplex&lt;/b&gt;&lt;br&gt;data quality, lineage, catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bq_pred" value="&lt;b&gt;BigQuery – Predictions &amp;amp; Decisions&lt;/b&gt;&lt;br&gt;audit trail + feedback labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="530" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- 4a. Offline AI -->
        <mxCell id="nlp_batch" value="&lt;b&gt;Offline NLP – historical claims&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Gemini batch. Runs once per load, not at scoring time.&lt;br&gt;• components and symptoms&lt;br&gt;• diagnosis and repair action&lt;br&gt;• structured JSON for the index and features&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9AB00;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="132" width="220" height="108" as="geometry" />
        </mxCell>
        <mxCell id="embed_batch" value="&lt;b&gt;Vertex AI Text Embeddings&lt;/b&gt;&lt;br&gt;embed historical cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9AB00;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="252" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="vs_index" value="&lt;b&gt;Vertex AI Vector Search&lt;/b&gt;&lt;br&gt;similar-case index (knowledge base)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9AB00;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="316" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="train" value="&lt;b&gt;Vertex AI Training&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;XGBoost / LightGBM. Target is the verified parts $ and labour hours of the &lt;b&gt;candidate repair&lt;/b&gt;, not the complaint alone.&lt;br&gt;Features: vehicle, year, engine, part no., dealer/region, complexity, catalogue price, guide hours.&lt;br&gt;Catalogue and labour guide stay authoritative. The model learns the usual paid outcome and the deviation.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9AB00;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="378" width="220" height="132" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;Model Registry + Evaluation&lt;/b&gt;&lt;br&gt;versioning, approval gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9AB00;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="522" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pipelines" value="&lt;b&gt;Vertex AI Pipelines&lt;/b&gt;&lt;br&gt;scheduled retraining &amp;amp; re-indexing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9AB00;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="582" width="220" height="48" as="geometry" />
        </mxCell>

        <!-- 4b. Online AI -->
        <mxCell id="extract_on" value="&lt;b&gt;① Online NLP – new claim&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Gemini on each claim. Same schema as offline.&lt;br&gt;• complaint, diagnosis, recommended repair&lt;br&gt;• inconsistencies and missing information&lt;br&gt;• entities used for retrieval and the cost model&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1105" y="132" width="215" height="108" as="geometry" />
        </mxCell>
        <mxCell id="embed_on" value="&lt;b&gt;② Embed claim text&lt;/b&gt;&lt;br&gt;Text Embeddings API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1105" y="252" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="retrieve" value="&lt;b&gt;③ Vector Search&lt;/b&gt;&lt;br&gt;Top-K similar historical cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1105" y="316" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rag" value="&lt;b&gt;④ Repair-fit validation&lt;/b&gt; (RAG)&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Separate from the price check. Asks whether the complaint and diagnosis support this repair.&lt;br&gt;Inputs: complaint, diagnosis, recommended repair, similar cases, inspection evidence.&lt;br&gt;Verdict: Supported · Potentially excessive · Insufficient evidence. Citations included.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1105" y="378" width="215" height="124" as="geometry" />
        </mxCell>
        <mxCell id="cost_ep" value="&lt;b&gt;⑤ Price check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Expected parts $ and labour hours for the &lt;b&gt;submitted repair&lt;/b&gt; (engine block, not “rattle”).&lt;br&gt;Baseline: parts catalogue and labour-time guide.&lt;br&gt;Model: expected range (P10–P90) and how far the quote deviates.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1105" y="514" width="215" height="108" as="geometry" />
        </mxCell>
        <mxCell id="monitor" value="&lt;b&gt;Model Monitoring + Gen AI Evaluation&lt;/b&gt;&lt;br&gt;drift, skew, groundedness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;strokeWidth=1.5;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1105" y="700" width="215" height="55" as="geometry" />
        </mxCell>

        <!-- 5. Decision & Serving -->
        <mxCell id="orch" value="&lt;b&gt;Cloud Run – Claim Validation API&lt;/b&gt;&lt;br&gt;orchestrates ① → ⑤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A142F4;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="140" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Rule Engine&lt;/b&gt; (Cloud Run)&lt;br&gt;• quote vs catalogue / guide and vs model range&lt;br&gt;• repair-fit verdict, kept separate from price&lt;br&gt;• history coverage / confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A142F4;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="250" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;AI Validation Report&lt;/b&gt; (JSON)&lt;br&gt;• Price of this repair: quote vs catalogue and model&lt;br&gt;• Repair-fit: Supported / Potentially excessive / Insufficient evidence&lt;br&gt;• If excessive, catalogue price of the smaller repair&lt;br&gt;• Action: Approve / Request evidence / Investigate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A142F4;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="390" width="220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Memorystore&lt;/b&gt;&lt;br&gt;cache for frequent lookups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A142F4;strokeWidth=1.5;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="555" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- 6. Consumption -->
        <mxCell id="agent_ui" value="&lt;b&gt;Claims Agent Workbench&lt;/b&gt;&lt;br&gt;report embedded in claim screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12B5CB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1690" y="140" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="agent_action" value="&lt;b&gt;Agent Decision&lt;/b&gt;&lt;br&gt;approve / adjust / reject / request info&lt;br&gt;(human-in-the-loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12B5CB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1690" y="265" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="looker" value="&lt;b&gt;Looker Dashboards&lt;/b&gt;&lt;br&gt;savings, flag precision, dealer trends (reads BigQuery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12B5CB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1690" y="400" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="alerts" value="&lt;b&gt;Dealer Pattern Alerts&lt;/b&gt;&lt;br&gt;repeat over-repair signals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12B5CB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1690" y="510" width="180" height="60" as="geometry" />
        </mxCell>

